# Dependencies
node_modules/
.venv/
__pycache__/
*.pyc

# Build and test output
dist/
build/
coverage/
*.tsbuildinfo

# Never commit a real student's imported schedule.
# The live copy lives in ${CLAUDE_PLUGIN_DATA}, but these patterns catch a stray
# local copy dropped into the repo during development. Files under
# schemas/examples/ are invented placeholders and are intentionally tracked.
schedules/
*.schedule.json
data/schedules/
plugins/*/data/schedules/

# Scratch work
scratch/
tmp/
*.local.json
*.log

# Editor and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
